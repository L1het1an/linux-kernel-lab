+static int proc_pid_sched_pick(struct seq_file *m, struct pid_namespace *ns,
+                               struct pid *pid, struct task_struct *task)
+{
+    seq_printf(m, "%lu\n", task->sched_pick_count);
+    return 0;
+}
+
+/* ËØªÂèñ task_limit ÁöÑÂΩìÂâçÂÄº */
+static int proc_pid_task_limit_seq_show(struct seq_file *m, void *v)
+{
+	struct inode *inode = file_inode(m->file);
+	struct task_struct *task = get_proc_task(inode);
+	int ret = -ESRCH;
+
+	if (task) {
+		/* ÊâìÂç∞ÈôêÂà∂ÂÄºÔºå‰ª•ÂèäÂΩìÂâçÂÆûÈôÖ‰∫ßÁîüÁöÑÂ≠êËøõÁ®ãÊï∞ */
+		seq_printf(m, "%d %d\n", task->task_limit, atomic_read(&task->child_count));
+		put_task_struct(task);
+		ret = 0;
+	}
+	return ret;
+}
+
+/* Â§ÑÁêÜÂÜôÂÖ• task_limit ÁöÑÈÄªËæë */
+static ssize_t proc_pid_task_limit_write(struct file *file, const char __user *buf,
+					 size_t count, loff_t *ppos)
+{
+	struct inode *inode = file_inode(file);
+	struct task_struct *task = get_proc_task(inode);
+	char buffer[16];
+	int limit;
+	int ret;
+
+	if (!task)
+		return -ESRCH;
+
+	if (*ppos > 0 || count > sizeof(buffer) - 1)
+		return -EINVAL;
+
+	/* ‰ªéÁî®Êà∑ÊÄÅÊã∑Ë¥ùÂ≠óÁ¨¶‰∏≤ */
+	if (copy_from_user(buffer, buf, count))
+		return -EFAULT;
+	buffer[count] = '\0';
+
+	/* Â∞ÜÂ≠óÁ¨¶‰∏≤ËΩ¨Êç¢‰∏∫Êï¥Êï∞ */
+	ret = kstrtoint(buffer, 10, &limit);
+	if (ret < 0)
+		goto out;
+
+	/* ÂÖÅËÆ∏ÂÜôÂÖ• -1Ôºå‰ª£Ë°®ÂèñÊ∂àÈôêÂà∂ÔºõÂ¶ÇÊûúÊòØÂÖ∂‰ªñË¥üÊï∞ÂàôÊä•Èîô */
+	if (limit < -1) {
+		ret = -EINVAL;
+		goto out;
+	}
+
+	/* ÂÜôÂÖ•Âà∞ task_structÔºàÈúÄË¶ÅÂä†ÈîÅ‰øùÊä§Ôºâ */
+	task_lock(task);
+	task->task_limit = limit;
+	/* Â¶ÇÊûúÈáçÊñ∞ËÆæÁΩÆ‰∫ÜÈÖçÈ¢ùÔºåÂèØ‰ª•ËÄÉËôëÈáçÁΩÆÂΩìÂâçËÆ°Êï∞ÔºåÊàñËÄÖ‰øùÊåÅÁé∞Áä∂„ÄÇËøôÈáå‰øùÊåÅÁé∞Áä∂ */
+	task_unlock(task);
+
+	*ppos += count;
+	ret = count;
+
+out:
+	put_task_struct(task);
+	return ret;
+}
+
+/* Ê°•Êé•ËØªÂèñÂáΩÊï∞ */
+static int proc_pid_task_limit_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, proc_pid_task_limit_seq_show, NULL);
+}
+
+/* ÂÆö‰πâÊñá‰ª∂Êìç‰ΩúÁªìÊûÑ‰Ωì */
+static const struct file_operations proc_pid_task_limit_operations = {
+	.open		= proc_pid_task_limit_open,
+	.read		= seq_read,
+	.write		= proc_pid_task_limit_write,
+	.llseek		= seq_lseek,
+	.release	= single_release,
+};
+
