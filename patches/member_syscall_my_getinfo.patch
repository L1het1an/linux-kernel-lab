diff --git a/include/uapi/linux/myinfo.h b/include/uapi/linux/myinfo.h
new file mode 100644
index 000000000..338e14143
--- /dev/null
+++ b/include/uapi/linux/myinfo.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0 WITH Linux-syscall-note */
+/*
+ * include/uapi/linux/myinfo.h
+ *
+ * 实验：新增系统调用 my_getinfo 的用户态 / 内核态共用结构体。
+ * 放在 uapi 目录下，执行 make headers_install（或安装 linux-libc-dev 包）后，
+ * 用户态程序可以直接 #include <linux/myinfo.h>。
+ *
+ * 注意：结构体一旦发布就不能改变字段含义，只能往后追加字段并用 size 协商，
+ *      这是内核 ABI 的基本纪律（报告里可以作为设计要点的加分项）。
+ */
+#ifndef _UAPI_LINUX_MYINFO_H
+#define _UAPI_LINUX_MYINFO_H
+
+#include <linux/types.h>
+
+#define MYINFO_MAX_COMM 16	/* 与内核 TASK_COMM_LEN 一致 */
+
+struct myinfo {
+	__u32 size;			/* 调用者填 sizeof(struct myinfo) */
+	__s32 pid;			/* 线程 ID（内核 task_pid_nr） */
+	__s32 tgid;			/* 进程 ID（内核 task_tgid_nr） */
+	__u32 state;			/* task_struct::__state 原始值 */
+	__s32 prio;			/* 动态优先级，越小越优先 */
+	__s32 static_prio;		/* 静态优先级 */
+	__s32 policy;			/* 调度策略：SCHED_NORMAL / SCHED_FIFO ... */
+	__s32 on_cpu;			/* 是否正在 CPU 上运行 */
+	__u64 utime;			/* 用户态累计 CPU 时间，单位 ns */
+	__u64 stime;			/* 内核态累计 CPU 时间，单位 ns */
+	__u64 nvcsw;			/* 主动上下文切换次数 */
+	__u64 nivcsw;			/* 被动上下文切换次数 */
+	char  comm[MYINFO_MAX_COMM];	/* 进程名 */
+};
+
+#endif /* _UAPI_LINUX_MYINFO_H */
