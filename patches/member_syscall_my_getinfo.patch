diff --git a/kernel/mycall.c b/kernel/mycall.c
new file mode 100644
index 000000000..f64a07167
--- /dev/null
+++ b/kernel/mycall.c
@@ -0,0 +1,86 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * kernel/mycall.c
+ *
+ * 实验：新增系统调用 my_getinfo（x86_64 编号见 syscall_64.tbl）
+ *
+ * 功能：读取指定进程（或线程）在内核里的关键状态，回填到用户态结构体
+ *       struct myinfo，供用户态程序观察进程管理模块的内部数据。
+ *
+ * 设计要点（报告里逐条对应）：
+ *   1) 用户态指针必须用 copy_to_user()/get_user() 访问，不能直接解引用；
+ *   2) 出错返回「负 errno」（-EINVAL/-ESRCH/-EFAULT），由 glibc 转成 errno；
+ *   3) task_struct 通过 get_pid_task() 拿到引用后必须 put_task_struct()；
+ *   4) 结构体带 size 字段做版本协商，便于以后向后兼容地扩展；
+ *   5) 真正的逻辑放在 kernel 内部函数 do_my_getinfo() 里，系统调用只做入口
+ *      （内核代码不应该相互调用 sys_xxx()）。
+ */
+
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/syscalls.h>
+#include <linux/pid.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <uapi/linux/myinfo.h>
+
+/* 把 task_struct 里关心的字段汇总到 myinfo（调用者需已持有 task 引用） */
+static void myinfo_fill(struct myinfo *info, struct task_struct *t)
+{
+	memset(info, 0, sizeof(*info));
+	info->size	= sizeof(*info);
+	info->pid	= task_pid_nr(t);
+	info->tgid	= task_tgid_nr(t);
+	info->state	= READ_ONCE(t->__state);
+	info->prio	= t->prio;
+	info->static_prio = t->static_prio;
+	info->policy	= t->policy;
+	info->on_cpu	= t->on_cpu;
+	info->utime	= t->utime;
+	info->stime	= t->stime;
+	info->nvcsw	= t->nvcsw;
+	info->nivcsw	= t->nivcsw;
+	get_task_comm(info->comm, t);
+}
+
+static long do_my_getinfo(pid_t pid, struct myinfo __user *uinfo)
+{
+	struct myinfo info;
+	struct task_struct *t;
+	struct pid *p;
+	u32 size;
+
+	if (!uinfo)
+		return -EINVAL;
+	if (pid <= 0)
+		return -EINVAL;
+
+	/* 版本协商：只接受与内核结构体完全一致的 size */
+	if (get_user(size, &uinfo->size))
+		return -EFAULT;
+	if (size != sizeof(struct myinfo))
+		return -EINVAL;
+
+	p = find_get_pid(pid);
+	if (!p)
+		return -ESRCH;
+	t = get_pid_task(p, PIDTYPE_PID);
+	put_pid(p);
+	if (!t)
+		return -ESRCH;
+
+	myinfo_fill(&info, t);
+	put_task_struct(t);
+
+	if (copy_to_user(uinfo, &info, sizeof(info)))
+		return -EFAULT;
+
+	pr_info("my_getinfo: pid=%d tgid=%d state=0x%x prio=%d comm=%s\n",
+		info.pid, info.tgid, info.state, info.prio, info.comm);
+	return 0;
+}
+
+SYSCALL_DEFINE2(my_getinfo, pid_t, pid, struct myinfo __user *, uinfo)
+{
+	return do_my_getinfo(pid, uinfo);
+}
