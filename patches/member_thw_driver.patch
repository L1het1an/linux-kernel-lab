+// SPDX-License-Identifier: GPL-2.0
+/*
+ * dataset_dev.c - dataset classifier char device
+ *
+ * write()  : 15840 bytes (60x33 doubles) -> classify
+ * read()   : struct dataset_result (24 bytes)
+ *
+ * 与第 548 号系统调用 kernel_dataset_classify 算法一致，
+ * 入口从 syscall 换成 VFS 文件操作。类中心内联，无外部头文件依赖。
+ */
+#include <linux/module.h>
+#include <linux/fs.h>
+#include <linux/miscdevice.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/mutex.h>
+#include <linux/device.h>
+#include <linux/ktime.h>
+#include <linux/atomic.h>
+#include <asm/fpu/api.h>
+
+#define TS_SAMPLES      60
+#define TS_CHANNELS     33
+#define TS_FEATDIM      (TS_CHANNELS * 3)
+#define DS_NCLASS       3
+#define DS_SAMPLE_BYTES (TS_SAMPLES * TS_CHANNELS * sizeof(double))
+
+struct dataset_result {
+    int    predict_class;
+    double min_distance;
+    double margin;
+};
+
+/* offline trained centroids, 3 classes x 99 features, index c*99+i */
+static const double DS_CLASS_CENTROID[DS_NCLASS * TS_FEATDIM] = {
+    1.01146839, 1.02643119, 0.99742623, 1.01163222, -0.00653295, 1.00000000,
+    0.99954642, 1.49573892, 0.02915887, 1.00785827, 1.00788917, -0.04107447,
