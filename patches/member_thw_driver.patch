+    0.32933016, 3.28899494, 1.02249222, 0.20253603, 5.79446564, 0.56850343,
+    0.07207538, 0.00000577, 0.59548983, 0.47671910, 0.10525278, 0.11592343,
+    0.37772272, 0.01411177, 7.83129889, 0.08360377, 0.01043629, 0.01214173,
+    0.18331825, 0.18816346, 0.17100171, 0.17898847, 11.01985814, 2.98538236,
+    3.15104032, 4.44220496, 0.07431352, 0.15431062, 0.14794356, 0.72862508,
+    0.21413524, 8.66768278, 0.76718599, 1.29528148, 15.32149156, 4.52203553,
+    0.69891200, 24.73940641, 3.26350466, 0.33689267, 0.00002123, 2.10767019,
+    1.61375416, 0.48997313, 0.46078356, 1.60211892, 0.04737517, 31.05391983,
+    0.34167903, 0.05734750, 0.06644061,
+};
+
+static struct dataset_result g_result;
+static DEFINE_MUTEX(g_lock);
+
+/* 性能统计：调用次数与累计耗时（纳秒） */
+static atomic64_t g_calls = ATOMIC64_INIT(0);
+static atomic64_t g_total_ns = ATOMIC64_INIT(0);
+
+/*
+ * 定点缓存：内核 vsnprintf 不支持 %f，故在 FPU 保护区内把 double
+ * 换算成放大 10000 倍的整数，供 sysfs 用纯整数格式化输出。
+ */
+static long g_md_int;
+static long g_mg_int;
+
+/* Newton iteration sqrt, avoid libm */
+static double my_sqrt(double a)
+{
+    double x;
+    int k;
+
+    if (a <= 0.0)
+        return 0.0;
+
+    x = a > 1.0 ? a : 1.0;
+    for (k = 0; k < 30; k++)
+        x = 0.5 * (x + a / x);
+
+    return x;
+}
+
+/* must be called inside kernel_fpu_begin()/end() */
+static void dataset_classify(const double *buf, struct dataset_result *out)
+{
+    double feat[TS_FEATDIM];
+    double dist[DS_NCLASS];
+    double second;
+    int i, j, c, r;
+
+    for (j = 0; j < TS_CHANNELS; j++) {
+        double sum = 0.0, sum2 = 0.0, mn = 1e300, mx = -1e300;
+
+        for (i = 0; i < TS_SAMPLES; i++) {
+            double v = buf[i * TS_CHANNELS + j];
+
+            sum += v;
+            sum2 += v * v;
+            if (v < mn)
+                mn = v;
+            if (v > mx)
+                mx = v;
+        }
+        feat[j] = sum / TS_SAMPLES;
+        feat[j + TS_CHANNELS] = my_sqrt(sum2 / TS_SAMPLES -
+                (sum / TS_SAMPLES) * (sum / TS_SAMPLES));
+        feat[j + 2 * TS_CHANNELS] = mx - mn;
+    }
+
+    for (c = 0; c < DS_NCLASS; c++) {
+        double d = 0.0;
+
+        for (i = 0; i < TS_FEATDIM; i++) {
+            double diff = feat[i] -
+                DS_CLASS_CENTROID[c * TS_FEATDIM + i];
+
+            d += diff * diff;
+        }
+        dist[c] = my_sqrt(d);
+    }
+
+    r = 0;
+    for (c = 1; c < DS_NCLASS; c++)
+        if (dist[c] < dist[r])
+            r = c;
+
+    second = 1e300;
+    for (c = 0; c < DS_NCLASS; c++)
+        if (c != r && dist[c] < second)
+            second = dist[c];
+
+    out->predict_class = r;
+    out->min_distance = dist[r];
+    out->margin = second - dist[r];
+}
+
+static ssize_t dataset_write(struct file *f, const char __user *ubuf,
+                             size_t len, loff_t *off)
+{
+    double *buf;
+    int ret;
+    u64 t0, t1;
+
+    if (len != DS_SAMPLE_BYTES)
+        return -EINVAL;
+
+    buf = kmalloc(DS_SAMPLE_BYTES, GFP_KERNEL);
+    if (!buf)
+        return -ENOMEM;
+
+    if (copy_from_user(buf, ubuf, DS_SAMPLE_BYTES)) {
+        ret = -EFAULT;
+        goto out_free;
+    }
+
+    t0 = ktime_get_ns();
+    mutex_lock(&g_lock);
+    kernel_fpu_begin();
+    dataset_classify(buf, &g_result);
+    /* 浮点转定点，必须在 FPU 保护区之内完成 */
+    g_md_int = (long)(g_result.min_distance * 10000.0);
+    g_mg_int = (long)(g_result.margin * 10000.0);
+    kernel_fpu_end();
+    mutex_unlock(&g_lock);
+    t1 = ktime_get_ns();
+
+    atomic64_inc(&g_calls);
+    atomic64_add(t1 - t0, &g_total_ns);
+
+    ret = len;
+out_free:
+    kfree(buf);
+    return ret;
+}
+
+static ssize_t dataset_read(struct file *f, char __user *ubuf,
+                            size_t len, loff_t *off)
+{
+    if (*off >= sizeof(g_result))
+        return 0;
+    if (len < sizeof(g_result))
+        return -EINVAL;
+    if (copy_to_user(ubuf, (const void *)&g_result, sizeof(g_result)))
+        return -EFAULT;
+    *off += sizeof(g_result);
+    return sizeof(g_result);
+}
+
+/* 允许 read 重置偏移：用户态需要 lseek(fd,0,SEEK_SET) 反复读同一结果 */
+static loff_t dataset_llseek(struct file *f, loff_t off, int whence)
+{
+    loff_t newpos;
+
+    switch (whence) {
+    case SEEK_SET:
+        newpos = off;
+        break;
+    case SEEK_CUR:
+        newpos = f->f_pos + off;
+        break;
+    case SEEK_END:
+        newpos = sizeof(g_result) + off;
+        break;
+    default:
+        return -EINVAL;
+    }
+    if (newpos < 0)
+        return -EINVAL;
+    f->f_pos = newpos;
+    return newpos;
+}
+
+static const struct file_operations dataset_fops = {
+    .owner = THIS_MODULE,
+    .write = dataset_write,
+    .read  = dataset_read,
+    .llseek = dataset_llseek,
+};
+
+static struct miscdevice dataset_miscdev = {
+    .minor = MISC_DYNAMIC_MINOR,
+    .name  = "dataset",
+    .fops  = &dataset_fops,
+    .mode  = 0666,
+};
+
+/*
+ * sysfs 只读属性：/sys/class/misc/dataset/last_result
+ * 展示最近一次分类结果，便于 shell 直接查看而无需编写程序。
+ */
+static ssize_t last_result_show(struct device *dev,
+                                struct device_attribute *attr, char *buf)
+{
+    return sprintf(buf,
+                   "predict_class=%d min_distance=%ld.%04ld margin=%ld.%04ld\n",
+                   g_result.predict_class,
+                   g_md_int / 10000, g_md_int % 10000,
+                   g_mg_int / 10000, g_mg_int % 10000);
+}
+static DEVICE_ATTR_RO(last_result);
+
+/*
+ * sysfs 只读属性：/sys/class/misc/dataset/stats
+ * 展示调用次数与累计/平均耗时（微秒），用于定量评估内核态开销。
+ */
+static ssize_t stats_show(struct device *dev,
+                          struct device_attribute *attr, char *buf)
+{
+    u64 calls = (u64)atomic64_read(&g_calls);
+    u64 total = (u64)atomic64_read(&g_total_ns);
+
+    return sprintf(buf, "calls=%llu\ntotal_us=%llu\navg_us=%llu\n",
+                   calls,
+                   (unsigned long long)div_u64(total, 1000),
+                   (unsigned long long)(calls ?
+                       div_u64(total, calls * 1000) : 0));
+}
+static DEVICE_ATTR_RO(stats);
+
+static int __init dataset_init(void)
+{
+    int ret = misc_register(&dataset_miscdev);
+
+    if (ret) {
+        pr_err("dataset: misc_register failed: %d\n", ret);
+        return ret;
+    }
+
+    ret = device_create_file(dataset_miscdev.this_device,
+                             &dev_attr_last_result);
+    if (ret) {
+        pr_err("dataset: create last_result failed: %d\n", ret);
+        goto err_misc;
+    }
+
+    ret = device_create_file(dataset_miscdev.this_device, &dev_attr_stats);
+    if (ret) {
+        pr_err("dataset: create stats failed: %d\n", ret);
+        device_remove_file(dataset_miscdev.this_device,
+                           &dev_attr_last_result);
+        goto err_misc;
+    }
+
+    pr_info("dataset: /dev/dataset ready, sample=%u bytes\n",
+            (unsigned int)DS_SAMPLE_BYTES);
+    return 0;
+
+err_misc:
+    misc_deregister(&dataset_miscdev);
+    return ret;
+}
+
+static void __exit dataset_exit(void)
+{
+    device_remove_file(dataset_miscdev.this_device, &dev_attr_stats);
+    device_remove_file(dataset_miscdev.this_device, &dev_attr_last_result);
+    misc_deregister(&dataset_miscdev);
+    pr_info("dataset: unloaded\n");
+}
+
+module_init(dataset_init);
+module_exit(dataset_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Dataset classifier char device");
+MODULE_AUTHOR("thw");
