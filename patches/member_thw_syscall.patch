+/*
+ * kernel_dataset_classifier.c
+ * ------------------------------------------------------------
+ * Linux 5.15 内核改造实验：新增第 548 号系统调用
+ *   "数据集统计特征提取 + 最近质心分类"
+ *
+ * 功能：
+ *   在内核态对一个 60×33 的浮点时序样本提取统计特征
+ *   （每个特征通道的时间均值、标准差、极差），并与预置的
+ *   三类类中心（由训练集离线计算得到）做欧氏距离最近质心分类，
+ *   返回预测类别（0 / 1 / 2）及最小距离 / 置信度 margin。
+ *
+ * 设计目标：
+ *   演示"用户态 → 系统调用 → 内核态处理数据 → 返回结果"完整链路，
+ *   体现对内核功能模块的新增与重构，并与 dataset 真实数据挂钩。
+ *
+ * 所属模块：内核系统调用（新增功能模块）
+ * 实验平台：Ubuntu + Linux 5.15.0（x86_64）
+ *
+ * 【浮点边界】本文件必须同时满足：
+ *   1. 编译期：由 kernel/Makefile 为本目标文件单独开启 -msse2，
+ *      否则 gcc 会报 "SSE register return with SSE disabled"。
+ *   2. 运行期：所有浮点运算必须位于 kernel_fpu_begin()/end() 之间；
+ *      拷贝用户数据等可能睡眠的操作必须在该区间之外。
+ */
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/errno.h>
+#include <asm/fpu/api.h>
+#include "dataset_centroids.h"
+
+/* 单个样本的维度参数 */
+#define TS_SAMPLES    60      /* 时间步 */
+#define TS_CHANNELS   33      /* 特征通道数 */
+#define TS_FEAT_DIM   99      /* 特征维数 = 33 × 3 */
+#define DS_SAMPLE_BYTES (TS_SAMPLES * TS_CHANNELS * (int)sizeof(double))
+
+/* 系统调用返回结构（与用户态 classify_test.c 中的定义必须逐字段一致） */
+struct dataset_result {
+	int	predict_class;	/* 预测类别 0/1/2 */
+	double	min_distance;	/* 最小欧氏距离 */
+	double	margin;		/* 次近 - 最近 距离差（置信度） */
+};
+
+/*
+ * 自定义开方：内核态不链接 libm，无法调用用户态 <math.h> 的 sqrt()。
+ * 用 Newton 迭代 x_{k+1} = 0.5 * (x_k + a / x_k) 实现。
+ */
+static double my_sqrt(double a)
+{
+	double x;
+	int k;
+
+	if (a <= 0.0)
+		return 0.0;
+	/* 初值取 max(a, 1)：对 a>1 收敛更快，对 a<1 避免初值为 0 除零 */
+	x = a > 1.0 ? a : 1.0;
+	for (k = 0; k < 30; k++)
+		x = 0.5 * (x + a / x);
+
+	return x;
+}
+
+SYSCALL_DEFINE3(kernel_dataset_classify,
+		void __user *, samples,
+		int, len,
+		struct dataset_result __user *, result)
+{
+	struct dataset_result res;
+	double *buf;
+	double feat[TS_FEAT_DIM];
+	double dist[DS_NCLASS];
+	double sum, sum2, mn, mx, v, d, diff, second;
+	int i, j, c, r;
+
+	/* 0) 参数校验 */
+	if (len != DS_SAMPLE_BYTES)
+		return -EINVAL;
+	if (!samples || !result)
+		return -EFAULT;
+
+	/*
+	 * 1) 内核态分配缓冲区并拷贝用户数据。
+	 *    copy_from_user 可能睡眠，且 -msse2 令本编译单元的栈操作也可能
+	 *    使用 SSE 指令，因此必须放在 kernel_fpu_begin() 之外。
+	 *    数据随即被完全覆盖，无需清零，用 kmalloc 即可。
+	 */
+	buf = kmalloc(DS_SAMPLE_BYTES, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	if (copy_from_user(buf, samples, DS_SAMPLE_BYTES)) {
+		kfree(buf);
+		return -EFAULT;
+	}
+
+	/* 2) 进入 FPU 保护区：此后不得调用任何可能睡眠的函数 */
+	kernel_fpu_begin();
+
+	/* 2.1) 提取统计特征：每通道 均值 / 标准差 / 极差 */
+	for (j = 0; j < TS_CHANNELS; j++) {
+		sum = 0.0;
+		sum2 = 0.0;
+		mn = 1e300;
+		mx = -1e300;
+		for (i = 0; i < TS_SAMPLES; i++) {
+			v = buf[i * TS_CHANNELS + j];
+			sum += v;
+			sum2 += v * v;
+			if (v < mn)
+				mn = v;
+			if (v > mx)
+				mx = v;
+		}
+		/* 均值 */
+		feat[j] = sum / TS_SAMPLES;
+		/* 标准差 = sqrt(E[x^2] - E[x]^2)，数值误差导致负数时 my_sqrt 返回 0 */
+		feat[j + TS_CHANNELS] =
+			my_sqrt(sum2 / TS_SAMPLES -
+				(sum / TS_SAMPLES) * (sum / TS_SAMPLES));
+		/* 极差 */
+		feat[j + 2 * TS_CHANNELS] = mx - mn;
+	}
+
+	/* 2.2) 与三类类中心计算欧氏距离 */
+	for (c = 0; c < DS_NCLASS; c++) {
+		d = 0.0;
+		for (i = 0; i < TS_FEAT_DIM; i++) {
+			diff = feat[i] - DS_CLASS_CENTROID[c * TS_FEAT_DIM + i];
+			d += diff * diff;
+		}
+		dist[c] = my_sqrt(d);
+	}
+
+	/* 2.3) 一趟循环求最近质心；再求次近距离。不硬编码类数 */
+	r = 0;
+	for (c = 1; c < DS_NCLASS; c++)
+		if (dist[c] < dist[r])
+			r = c;
+
+	second = 1e300;
+	for (c = 0; c < DS_NCLASS; c++)
+		if (c != r && dist[c] < second)
+			second = dist[c];
+
+	res.predict_class = r;
+	res.min_distance = dist[r];
+	res.margin = second - dist[r];
+
+	/* 3) 离开 FPU 保护区 */
+	kernel_fpu_end();
+
+	/* 4) 结果写回用户态（同样必须在保护区之外） */
+	if (copy_to_user(result, &res, sizeof(res))) {
+		kfree(buf);
+		return -EFAULT;
+	}
+
+	kfree(buf);
+	return 0;
+}
